programa {
  funcao inicio() {
    
      escreva ("\n Boletim de lançamento de notas")

    cadeia nome
    cadeia curso
    cadeia disciplina
    inteiro nota

      escreva("\nnome do(a) aluno(a): ")
    leia (nome)

      escreva ("\nCurso: ")
    leia (curso)
    
      escreva ("\nDisciplina: ")
    leia(disciplina)

      escreva ("\nnota: ")
    leia (nota)

      se (nota >= 59 e nota <= 100)
   {
    escreva("Está APROVADO")
   }
    senao {
       se(nota <=19)
    
    {
      escreva("Está REPROVADO")
    }
    senao {
      escreva ("Esta de RECUPERAÇÃO")
    }
    }
  }
}
